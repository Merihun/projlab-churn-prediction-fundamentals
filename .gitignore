# Secrets and local overrides: never commit these.
.env
.env.*
!.env.example

# Python / Jupyter
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/

# Spark / Delta Lake local state
spark-warehouse/
metastore_db/
derby.log

# dbt build output
dbt/target/
dbt/logs/
dbt/dbt_packages/
logs/

# Local data files stay on your machine; commit small samples with `git add -f`.
data/*
!data/.gitkeep

# OS junk
.DS_Store
Thumbs.db

# Churn project: the export is generated (make data); the model and the lists are rebuilt by make train/score.
models/
out/
.ruff_cache/
